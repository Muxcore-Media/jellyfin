[Unit]
Description=MuxCore Module - jellyfin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/jellyfin \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id jellyfin
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muxcore-jellyfin

[Install]
WantedBy=multi-user.target
