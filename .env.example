# MuxCore Jellyfin module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true
# MUXCORE_MODULE_ID=jellyfin

# Listen addresses
# JELLYFIN_GRPC_ADDR=:9475
# JELLYFIN_HTTP_ADDR=:8475

# Jellyfin server (JELLYFIN_URL is an alias for JELLYFIN_BASE_URL)
# JELLYFIN_BASE_URL=http://jellyfin:8096
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=

# Webhook shared secret (X-Jellyfin-Webhook-Secret or Authorization: Bearer)
# JELLYFIN_WEBHOOK_SECRET=

# Durable settings + item-link store
# JELLYFIN_DATA_DIR=/var/lib/muxcore-jellyfin

# Library sync conflict mode: jellyfin | muxcore | manual
# JELLYFIN_CONFLICT_MODE=jellyfin

# Optional /Sessions poll interval (0 = webhooks only)
# JELLYFIN_SESSIONS_POLL_SECONDS=0
# JELLYFIN_SSE=1

# Userdata handoff (progress / watched / favorites)
# USERDATA_SYNC=1
# USERDATA_SYNC_INTERVAL_SECONDS=300
# USERDATA_LOCAL_URL=http://userdata-local:9680
# USERDATA_PUSH_TO_JELLYFIN=1
# USERDATA_USER_MAP=jf-user-guid:alice
